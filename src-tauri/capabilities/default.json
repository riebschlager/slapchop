{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Slapchop desktop permissions for dialogs and user-chosen project and export paths. Native video encoding is exposed only through narrow application commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-stat",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }, { "path": "$TEMP/**" }]
    }
  ]
}
